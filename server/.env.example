# Copy to .env for local development. Never commit the real .env.

# --- Required in production ---
# Signing key for access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development, playkit generates a throwaway secret if this is unset.
JWT_SECRET=

# --- Server ---
PORT=4000
HOST=127.0.0.1
# Where the SQLite file lives. Must be on a persistent disk in production.
DATABASE_PATH=./data/playkit.db

# --- CORS ---
# Exact origins allowed to call the API, comma separated. No wildcards: the API
# sends cookies, and browsers reject `*` for credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Games ---
# Registered game ids. A save or score for an unlisted id is rejected.
GAME_IDS=investment-time-machine,webcam-pose-runner,dance-trainer
MAX_SAVE_BYTES=262144

# --- Google sign-in (optional) ---
# OAuth 2.0 *Web application* client ID from Google Cloud Console.
# Only the client ID is needed — playkit verifies ID tokens against Google's
# public keys, so there is no client secret to store.
GOOGLE_CLIENT_ID=

# --- Rate limiting (optional overrides) ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=900000
SIGNUP_MAX_ATTEMPTS=5
SIGNUP_WINDOW_MS=3600000

# --- Password reset (optional) ---
# Where the reset link points — playkit hosts the page itself at PUBLIC_URL/reset.
# Required as soon as EMAIL_PROVIDER is set; the server refuses to start without it.
PUBLIC_URL=https://your-playkit-host
RESET_TOKEN_TTL_MINUTES=30
RESET_MAX_ATTEMPTS=5
RESET_WINDOW_MS=3600000

# How mail goes out. Leave EMAIL_PROVIDER empty and reset links are logged to the
# server console instead of sent — useful in development, refused in production.
#   smtp   — any mailbox; a Gmail app password is the usual case. Sends to
#            any address, free, no domain needed.
#   resend — HTTP API, no dependency, but sending to arbitrary addresses
#            requires a domain you have verified with them.
EMAIL_PROVIDER=
EMAIL_FROM="Your Game <you@example.com>"

# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=            # a Gmail *app password*, never your real one

# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
